---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { SITE } from '../config.js';
import { categorizar, CATEGORIAS } from '../lib/categorias.js';
import dados from '../data/pets.json';
import { env } from 'cloudflare:workers';
import { listarAnimais, carregarConfig, contarPorStatus } from '../lib/db';

// remove acentos para busca sem diferenciar acentuação
const semAcento = (s) =>
  (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

const especieInfo = {
  cachorro: { label: 'Cachorro' },
  gato: { label: 'Gato' },
  indefinido: { label: 'Pet' },
};

// ---- carrega do banco (D1); se indisponível, cai para o pets.json estático ----
const db = (env as any)?.DB;
let animais = [];
let cfg = {};
let contagem = null;
if (db) {
  try {
    animais = await listarAnimais(db, { apenasAtivos: true });
    cfg = await carregarConfig(db);
    contagem = await contarPorStatus(db);
  } catch (e) {
    console.warn('Banco indisponível — usando pets.json como fallback.', e);
  }
}
if (!animais.length) {
  animais = dados.pets.map((p, i) => ({
    ...p,
    especie: p.especie || 'indefinido',
    categoria: categorizar(p.pedido),
    status: 'disponivel',
    ordem: i,
  }));
}

// textos/numeros da campanha (config do banco com fallback no config.js)
const ano = cfg.campanha_ano || SITE.ano;
const marca = cfg.campanha_marca || SITE.marca;
const slogan = cfg.campanha_slogan || SITE.slogan;
const descricao = cfg.campanha_descricao || SITE.descricao;
let whatsapp = SITE.whatsapp;
try {
  if (cfg.telefones) whatsapp = JSON.parse(cfg.telefones);
} catch {}

// enriquece cada animal para a view
const petsView = animais.map((p) => ({
  ...p,
  categoria: p.categoria || categorizar(p.pedido),
  busca: semAcento(`${p.nome} ${p.pedido} ${p.historia}`),
  indisponivel: !!(p.status && p.status !== 'disponivel'),
  // posição da foto (object-position) ajustável por animal; padrão enquadra o rosto
  pos: (p.foto_posicao && String(p.foto_posicao).trim()) || '50% 42%',
}));

const totalPets = petsView.length;
const totalCachorros = petsView.filter((p) => p.especie === 'cachorro').length;
const totalGatos = petsView.filter((p) => p.especie === 'gato').length;

// contadores reais (do banco; fallback calculado da própria view)
const nIndisponiveis = contagem
  ? totalPets - contagem.disponivel
  : petsView.filter((p) => p.indisponivel).length;
const nDisponiveis = totalPets - nIndisponiveis;

// pet de destaque no hero (prioriza um disponível)
const heroPet =
  petsView.find((p) => p.id === 'branca' && !p.indisponivel) ||
  petsView.find((p) => !p.indisponivel) ||
  petsView[0];

// dados enviados ao cliente (para o modal e o fluxo de adoção)
const petsClient = petsView.map((p) => ({
  id: p.id,
  nome: p.nome,
  especie: p.especie,
  pedido: p.pedido,
  cartinha: p.cartinha,
  foto: p.foto,
  pos: p.pos,
}));
const configClient = { whatsapp, marca };
---

<Layout>
  <!-- CABEÇALHO -->
  <header class="cabecalho">
    <div class="container cabecalho-inner">
      <a href="#topo" class="logo">
        <span>Adote uma Carta<br /><small style="font-weight:400;color:var(--tinta-suave);font-size:.72rem">{marca}</small></span>
      </a>
      <span class="chip-contador">
        <b id="chip-num">{nIndisponiveis}</b>&nbsp;cartinhas já realizadas
      </span>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero" id="topo">
    <div class="container hero-grid">
      <div>
        <span class="hero-selo">Campanha de Natal {ano} · {marca}</span>
        <h1>Realize o <span class="destaque">desejo</span> de um pet neste Natal</h1>
        <p class="sub">{descricao}</p>
        <div class="hero-ctas">
          <a href="#cartinhas" class="btn btn-claro">Ver as cartinhas</a>
          <a href="#como" class="btn btn-fantasma" style="color:#fff;border-color:rgba(255,255,255,.45)">Como funciona</a>
        </div>
        <div class="stats">
          <div class="stat">
            <div class="num">{totalPets}</div>
            <div class="rot">cartinhas de pets</div>
          </div>
          <div class="stat">
            <div class="num" id="stat-adotadas">{nIndisponiveis}</div>
            <div class="rot">já realizadas</div>
          </div>
          <div class="stat">
            <div class="num" id="stat-disponiveis">{nDisponiveis}</div>
            <div class="rot">esperando um padrinho</div>
          </div>
        </div>
      </div>
      <div class="hero-card">
        <img src={heroPet.foto} alt={`Foto de ${heroPet.nome}`} width="340" height="255" style={`object-position:${heroPet.pos}`} />
        <div class="legenda">{heroPet.nome} está esperando por você</div>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="secao" id="como">
    <div class="container">
      <div class="secao-titulo">
        <h2>Como funciona</h2>
        <p>Em três passinhos você transforma o Natal de um pet que só espera por carinho.</p>
      </div>
      <div class="passos">
        <div class="passo">
          <span class="numero">1</span>
          <h3>Escolha uma cartinha</h3>
          <p>Leia as histórias e descubra qual pedido de Natal você quer realizar.</p>
        </div>
        <div class="passo">
          <span class="numero">2</span>
          <h3>Garanta o presentinho</h3>
          <p>Clique em “Adotar esta carta”, faça sua reserva e escolha como presentear.</p>
        </div>
        <div class="passo">
          <span class="numero">3</span>
          <h3>Leve alegria</h3>
          <p>Conclua sua contribuição e faça o Natal de um focinho muito mais feliz.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GALERIA -->
  <section class="secao galeria-topo" id="cartinhas">
    <div class="container">
      <div class="secao-titulo">
        <h2>Escolha uma cartinha</h2>
        <p>{totalPets} pets escreveram para o Papai Noel. Use a busca e os filtros para encontrar quem tocar seu coração.</p>
      </div>

      <!-- FILTROS -->
      <div class="filtros" role="search">
        <div class="busca">
          <input type="search" id="busca" placeholder="Buscar por nome ou pedido..." aria-label="Buscar cartinha" />
        </div>
        <div class="grupo-filtro" id="filtro-especie" role="group" aria-label="Filtrar por tipo">
          <button class="pilula" data-f="especie" data-v="todos" aria-pressed="true">Todos</button>
          <button class="pilula" data-f="especie" data-v="cachorro" aria-pressed="false">Cães ({totalCachorros})</button>
          <button class="pilula" data-f="especie" data-v="gato" aria-pressed="false">Gatos ({totalGatos})</button>
        </div>
        <div class="grupo-filtro" id="filtro-categoria" role="group" aria-label="Filtrar por presente">
          <button class="pilula" data-f="categoria" data-v="todos" aria-pressed="true">Todos os presentes</button>
          {Object.entries(CATEGORIAS).map(([k, c]) => (
            <button class="pilula" data-f="categoria" data-v={k} aria-pressed="false">{c.label}</button>
          ))}
        </div>
        <div class="grupo-filtro" id="filtro-status" role="group" aria-label="Filtrar por disponibilidade">
          <button class="pilula" data-f="status" data-v="todos" aria-pressed="true">Todas</button>
          <button class="pilula" data-f="status" data-v="disponivel" aria-pressed="false">Disponíveis</button>
          <button class="pilula" data-f="status" data-v="adotada" aria-pressed="false">Realizadas</button>
        </div>
      </div>

      <p class="contagem-resultado"><span id="n-resultado">{totalPets}</span> cartinhas encontradas</p>

      <!-- GRADE -->
      <div class="grade" id="grade">
        {petsView.map((p) => {
          const info = especieInfo[p.especie] || especieInfo.indefinido;
          const cat = CATEGORIAS[p.categoria] || CATEGORIAS.outros;
          return (
            <article
              class={`card${p.indisponivel ? ' adotada' : ''}`}
              data-id={p.id}
              data-especie={p.especie}
              data-categoria={p.categoria}
              data-status={p.status}
              data-busca={p.busca}
              style={`--pos:${p.pos}`}
              tabindex="0"
              role="button"
              aria-label={`Ver cartinha de ${p.nome}`}
            >
              <div class="card-foto">
                <img src={p.foto} alt={`Foto de ${p.nome}`} loading="lazy" width="320" height="240" />
                <span class="badge-especie">{info.label}</span>
                <span class="badge-status disp">Disponível</span>
                <span class="selo-adotada">Realizada</span>
              </div>
              <div class="card-corpo">
                <h3>{p.nome}</h3>
                <p class="card-pedido"><span class="lab">Pede de Natal:</span> {p.pedido}</p>
                <div class="card-rodape">
                  <span class="tag-presente">{cat.label}</span>
                  <span class="ver-mais">ver cartinha →</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div class="vazio" id="vazio" style="display:none">
        <p>Nenhuma cartinha encontrada com esses filtros.<br />Tente outra busca!</p>
      </div>
    </div>
  </section>

  <!-- RODAPÉ -->
  <footer class="rodape" id="contato">
    <div class="container rodape-grid">
      <div class="rodape-col">
        <h3>Adote uma Carta</h3>
        <p>
          Uma campanha de Natal do {marca}. Cada cartinha é o pedido de um pet
          de abrigo — e cada presente, um gesto de carinho por quem só espera por um lar.
        </p>
      </div>
      <div class="rodape-col">
        <strong>A campanha</strong>
        <div class="rodape-info">
          <span class="dourado">{marca}</span>
          <span>{slogan}</span>
          <span>Natal {ano}</span>
        </div>
      </div>
      <div class="rodape-col">
        <strong>Fale com a gente</strong>
        {whatsapp.map((n) => (
          <a class="wa" href={`https://wa.me/${n}`} target="_blank" rel="noopener">
            +{n.replace(/^55/, '55 ')}
          </a>
        ))}
      </div>
    </div>
    <div class="container rodape-base">
      © {ano} {marca} — {slogan}. Todas as fotos e histórias pertencem à campanha.
    </div>
  </footer>

  <!-- MODAL -->
  <div class="modal-backdrop" id="modal" role="dialog" aria-modal="true" aria-labelledby="modal-nome">
    <div class="modal">
      <button class="modal-fechar" id="fechar" aria-label="Fechar">×</button>
      <div class="modal-foto">
        <img id="modal-img" src="" alt="" />
      </div>
      <div class="modal-conteudo">
        <h2 id="modal-nome"></h2>
        <div class="modal-especie" id="modal-especie"></div>

        <!-- ETAPA 1 · CARTINHA -->
        <div class="tela ativa" data-tela="carta">
          <div class="carta" id="modal-carta"></div>
          <div class="pedido-destaque">
            <span class="lab">Presente de Natal desejado</span>
            <span id="modal-pedido"></span>
          </div>
          <div class="modal-acoes" id="acoes">
            <button class="btn btn-vermelho" id="btn-adotar">Adotar esta carta</button>
            <span id="aviso-adotada" style="display:none;text-align:center;color:var(--verde);font-weight:600">
              Esta cartinha já foi reservada. Que tal escolher outra?
            </span>
          </div>
        </div>

        <!-- ETAPA 2 · CADASTRO + MODALIDADE -->
        <div class="tela" data-tela="cadastro">
          <form id="form-cadastro">
            <p class="passo-ind">Passo 1 de 2 · Seus dados</p>
            <div class="campo">
              <label for="f-nome">Nome completo *</label>
              <input type="text" id="f-nome" name="nome" required maxlength="80" placeholder="Seu nome completo" />
            </div>
            <div class="form-linha">
              <div class="campo">
                <label for="f-whatsapp">WhatsApp *</label>
                <input type="tel" id="f-whatsapp" name="whatsapp" maxlength="40" placeholder="(62) 90000-0000" />
              </div>
              <div class="campo">
                <label for="f-email">E-mail</label>
                <input type="email" id="f-email" name="email" maxlength="120" placeholder="voce@email.com" />
              </div>
            </div>

            <p class="passo-ind">Passo 2 de 2 · Como quer presentear?</p>
            <div class="modalidades" role="radiogroup" aria-label="Modalidade de presente">
              <label class="modalidade-op">
                <input type="radio" name="modalidade" value="pix" required />
                <span class="mo-card"><b>PIX</b><small>Contribua com um valor por PIX</small></span>
              </label>
              <label class="modalidade-op">
                <input type="radio" name="modalidade" value="compra_online" />
                <span class="mo-card"><b>Compra online</b><small>Compre o presente pela internet</small></span>
              </label>
              <label class="modalidade-op">
                <input type="radio" name="modalidade" value="entrega_presencial" />
                <span class="mo-card"><b>Entrega presencial</b><small>Leve o presente até o abrigo</small></span>
              </label>
            </div>

            <div class="form-erro" id="form-erro"></div>
            <button type="submit" class="btn btn-primario" id="btn-confirmar-reserva">Confirmar reserva</button>
            <button type="button" class="btn btn-fantasma" data-voltar="carta">Voltar</button>
          </form>
        </div>

        <!-- ETAPA 3 · PIX -->
        <div class="tela" data-tela="pix">
          <div class="box-modalidade">
            <h3>Contribua por PIX</h3>
            <p class="ajuda">Use a chave abaixo (ou o QR Code) e, se puder, envie o comprovante para agilizarmos a confirmação.</p>
            <div class="pix-chave-wrap" id="pix-chave-wrap">
              <code id="pix-chave"></code>
              <button type="button" class="btn btn-pequeno" id="btn-copiar-pix">Copiar</button>
            </div>
            <img id="pix-qr" class="pix-qr" src="" alt="QR Code do PIX" style="display:none" />
            <p class="pix-sem" id="pix-sem" style="display:none">A chave PIX ainda não foi cadastrada. Fale com a gente pelo WhatsApp.</p>

            <div class="comprovante">
              <label for="f-comprovante">Enviar comprovante (opcional)</label>
              <input type="file" id="f-comprovante" accept="image/png,image/jpeg,image/webp,application/pdf" />
              <button type="button" class="btn btn-whatsapp btn-pequeno" id="btn-enviar-comprovante">Enviar comprovante</button>
              <span class="comprovante-status" id="comprovante-status"></span>
            </div>
          </div>
          <button type="button" class="btn btn-primario" data-ir="sucesso">Concluir</button>
          <button type="button" class="btn btn-fantasma" data-voltar="cadastro">Voltar</button>
        </div>

        <!-- ETAPA 4 · COMPRA ONLINE -->
        <div class="tela" data-tela="compra">
          <div class="box-modalidade">
            <h3>Compre o presente online</h3>
            <p class="ajuda">Escolha um dos links abaixo. A loja abre em outra janela. Depois, registre seu compromisso.</p>
            <div class="compra-links" id="compra-links"></div>
            <p class="compra-sem" id="compra-sem" style="display:none">Ainda não há links cadastrados para esta cartinha — você pode combinar a compra pelo WhatsApp.</p>
          </div>
          <button type="button" class="btn btn-primario" id="btn-compra-registrar">Registrar meu compromisso</button>
          <button type="button" class="btn btn-fantasma" data-voltar="cadastro">Voltar</button>
        </div>

        <!-- ETAPA 5 · ENTREGA PRESENCIAL -->
        <div class="tela" data-tela="presencial">
          <div class="box-modalidade">
            <h3>Entrega presencial</h3>
            <p class="ajuda" id="presencial-orientacoes"></p>
            <div class="endereco-box" id="presencial-endereco"></div>
            <div class="campo">
              <label for="f-previsao">Quando pretende entregar? (opcional)</label>
              <input type="text" id="f-previsao" maxlength="40" placeholder="Ex.: até 20/12 ou neste sábado" />
            </div>
          </div>
          <button type="button" class="btn btn-primario" id="btn-presencial-registrar">Registrar previsão de entrega</button>
          <button type="button" class="btn btn-fantasma" data-voltar="cadastro">Voltar</button>
        </div>

        <!-- ETAPA 6 · SUCESSO -->
        <div class="tela tela-sucesso" data-tela="sucesso">
          <h3>Reserva confirmada!</h3>
          <p class="sucesso-sub" id="suc-sub"></p>
          <div class="sucesso-info">
            <div><span class="lab">Código da reserva</span><b id="suc-codigo"></b></div>
            <div><span class="lab">Modalidade</span><b id="suc-modalidade"></b></div>
          </div>
          <div class="sucesso-orient" id="suc-orientacoes"></div>
          <button type="button" class="btn btn-whatsapp" id="btn-whatsapp-share">Compartilhar no WhatsApp</button>
          <button type="button" class="btn btn-fantasma" id="btn-fechar-sucesso">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <!-- dados para o cliente -->
  <script type="application/json" id="dados-pets" set:html={JSON.stringify(petsClient)}></script>
  <script type="application/json" id="dados-config" set:html={JSON.stringify(configClient)}></script>

  <script src="../scripts/app.js"></script>
</Layout>

---
export const prerender = false;
import '../../styles/global.css';
import { env } from 'cloudflare:workers';
import { adminDoToken, COOKIE } from '../../lib/auth';

// se já estiver logado, vai direto pro painel
const db = (env as any)?.DB;
if (db) {
  const token = Astro.cookies.get(COOKIE)?.value;
  const admin = await adminDoToken(db, token).catch(() => null);
  if (admin) return Astro.redirect('/admin');
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar — Painel Natal PET</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎄</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="login-body" style="font-family:var(--fonte-texto)">
    <form class="login-card" id="form-login">
      <div class="login-logo">🎄</div>
      <h1>Painel Natal PET</h1>
      <p class="login-sub">Entre para administrar a campanha.</p>
      <label for="email">E-mail</label>
      <input type="email" id="email" required autocomplete="username" placeholder="admin@natalpet.com.br" />
      <label for="senha">Senha</label>
      <input type="password" id="senha" required autocomplete="current-password" placeholder="Sua senha" />
      <div class="admin-msg err" id="erro"></div>
      <button type="submit" class="btn btn-primario" id="btn-entrar">Entrar</button>
    </form>

    <script>
      const form = document.getElementById('form-login');
      const erro = document.getElementById('erro');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        erro.textContent = '';
        const btn = document.getElementById('btn-entrar');
        btn.disabled = true;
        btn.textContent = 'Entrando...';
        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: document.getElementById('email').value,
              senha: document.getElementById('senha').value,
            }),
          });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.erro || 'Falha ao entrar');
          location.href = '/admin';
        } catch (err) {
          erro.textContent = err.message;
          btn.disabled = false;
          btn.textContent = 'Entrar';
        }
      });
    </script>

    <style>
      .login-body { min-height: 100vh; display: grid; place-items: center; background: linear-gradient(160deg, var(--verde) 0%, var(--verde-escuro) 100%); padding: 20px; }
      .login-card { background: #fff; border-radius: 16px; padding: 32px; width: 100%; max-width: 380px; box-shadow: var(--sombra-forte); display: flex; flex-direction: column; gap: 6px; }
      .login-logo { font-size: 2.6rem; text-align: center; }
      .login-card h1 { font-family: var(--fonte-titulo); color: var(--verde); font-size: 1.6rem; font-weight: 700; text-align: center; }
      .login-sub { color: #6a7a70; font-size: 0.9rem; text-align: center; margin-bottom: 14px; }
      .login-card label { font-size: 0.82rem; font-weight: 600; color: var(--verde); margin-top: 8px; }
      .login-card input { padding: 11px 13px; border: 1.5px solid #d8ddd8; border-radius: 9px; font-size: 1rem; font-family: inherit; }
      .login-card input:focus { outline: none; border-color: var(--dourado); }
      .login-card .btn { margin-top: 14px; }
      .admin-msg { font-size: 0.86rem; min-height: 1em; }
      .admin-msg.err { color: var(--vermelho); }
    </style>
  </body>
</html>
